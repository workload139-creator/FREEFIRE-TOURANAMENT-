DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=

SITE_NAME=FF Tournament
SITE_CURRENCY=INR

MAX_PLAYERS_PER_TOURNAMENT=49
MINIMUM_DEPOSIT=10
MAX_PLAYER_WALLET_BALANCE=5000

# Cashfree Payment Gateway (use sandbox keys for testing).
# Real payments require Cashfree approval and production credentials.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_MODE=sandbox

# FF Arena tournament entry receiving UPI (manual UTR verification; keep actual account details private)
FF_ARENA_UPI_ID=
FF_ARENA_UPI_NAME=
MINIMUM_WITHDRAWAL=10
REWARD_PER_APPROVED_KILL=5
MINIMUM_VERIFIED_KILLS=2

# Optional AI evidence review (never authorizes payouts)
# Default provider: OpenAI Responses API
KILL_REVIEW_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_KILL_REVIEW_MODEL=gpt-4.1-mini
# For a compatible vision endpoint (e.g. Ollama Cloud or a secured hosted Ollama server), set:
# KILL_REVIEW_PROVIDER=compatible
# KILL_REVIEW_BASE_URL=https://ollama.com/v1
# KILL_REVIEW_API_KEY=replace-with-provider-key
# OPENAI_KILL_REVIEW_MODEL=<vision-model-id>
# Do not set KILL_REVIEW_BASE_URL to localhost on Render.
# Leave blank to use the FFmpeg binary bundled by imageio-ffmpeg.
FFMPEG_PATH=

# Preferred on Render Free: Brevo API over HTTPS (never commit the real key).
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account.
DEFAULT_FROM_EMAIL=
# Optional SMTP fallback for local/paid environments.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
