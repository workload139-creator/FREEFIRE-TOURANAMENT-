DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=

# Durable player photos, UPI QR images and match evidence on Cloudinary.
# Create a Cloudinary account, then copy its CLOUDINARY_URL into Render Environment.
# Leave blank only for local development; Render local media is not durable.
CLOUDINARY_URL=

SITE_NAME=FF Tournament
SITE_CURRENCY=INR

MAX_PLAYERS_PER_TOURNAMENT=49
MINIMUM_DEPOSIT=10
MAX_PLAYER_WALLET_BALANCE=5000


# FF Arena tournament entry receiving UPI (manual UTR verification; keep actual account details private)
FF_ARENA_UPI_ID=
FF_ARENA_UPI_NAME=
MINIMUM_WITHDRAWAL=10
REWARD_PER_APPROVED_KILL=5
MINIMUM_VERIFIED_KILLS=2

# Optional AI evidence review. Both models must independently agree on UID,
# personal kills and matching/complete Free Fire history/video evidence before reward.
# If either model fails, evidence is incomplete, or results disagree, Admin Review is required.
# OpenAI primary assessment
KILL_REVIEW_PROVIDER=dual
OPENAI_API_KEY=
OPENAI_KILL_REVIEW_MODEL=gpt-4.1-mini
# Secondary open-source vision model via Ollama Cloud or another OpenAI-compatible endpoint
KILL_REVIEW_BASE_URL=https://ollama.com/v1
KILL_REVIEW_API_KEY=
OLLAMA_KILL_REVIEW_MODEL=gemma4
# The selected endpoint/model must support image inputs and be reachable securely from Render.
# Do NOT use localhost/127.0.0.1 on Render. Never expose an unauthenticated Ollama port to the public internet.
# Leave blank to use the FFmpeg binary bundled by imageio-ffmpeg.
FFMPEG_PATH=

# Preferred on Render Free: Brevo API over HTTPS (never commit the real key).
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account.
DEFAULT_FROM_EMAIL=
# Optional SMTP fallback for local/paid environments.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Unlimited Tournament live-start email alerts
TOURNAMENT_ADMIN_EMAIL=your-admin-email@gmail.com
SITE_URL=https://freefire-touranament-74nr.onrender.com
