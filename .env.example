DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=

SITE_NAME=FF Tournament
SITE_CURRENCY=INR

MAX_PLAYERS_PER_TOURNAMENT=49
MINIMUM_DEPOSIT=10
MAX_PLAYER_WALLET_BALANCE=5000
MINIMUM_WITHDRAWAL=10
REWARD_PER_APPROVED_KILL=5
MINIMUM_VERIFIED_KILLS=2

# Optional AI evidence review (never authorizes payouts)
OPENAI_API_KEY=
OPENAI_KILL_REVIEW_MODEL=gpt-4.1-mini
# Leave blank to use the FFmpeg binary bundled by imageio-ffmpeg.
FFMPEG_PATH=

# Brevo SMTP: set these in Render Environment Variables (never commit the real key).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
